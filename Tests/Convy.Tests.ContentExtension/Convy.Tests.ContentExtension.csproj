<Project Sdk="Microsoft.NET.Sdk">

  <!-- A source extension of Convy's own API as one is built: against Convy.Sources.Abstractions and the shared
       Shizuka.Sources.Abstractions, both provided by the host. The tests load its DLL from the extensions folder of
       their output like a user would. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shizuka.Sources.Abstractions" Version="1.6.0" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\src\Convy.Sources.Abstractions\Convy.Sources.Abstractions.csproj" Private="false" />
  </ItemGroup>

</Project>
