<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Convy.Services\Convy.Services.csproj" />
    <!-- Built, never referenced: the plugin tests load its DLL from plugins/ of the output like a user would. -->
    <ProjectReference Include="..\Convy.Sources.TestPlugin\Convy.Sources.TestPlugin.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyTestPlugin" AfterTargets="Build">
    <MSBuild Projects="..\Convy.Sources.TestPlugin\Convy.Sources.TestPlugin.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="TestPlugin" />
    </MSBuild>
    <Copy SourceFiles="@(TestPlugin)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="true" />
  </Target>

</Project>