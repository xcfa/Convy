<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Shizuka.Sources.* (the extension API and its hosting, which Convy runs extensions with) live in GitHub Packages,
    which NuGet reads only with a token (right read:packages): put a personal access token into the environment
    variable PACKAGES_TOKEN (CI and the image build: the secret PACKAGES_TOKEN, else the job's own token). The user name is not checked but must
    be set. Without the token the packages can come from a folder of .nupkg files packed from a Shizuka checkout
    (dotnet pack of Shizuka.Sources.Abstractions and Shizuka.Sources.Hosting) and a config of your own that names that
    folder for Shizuka.* (dotnet restore configfile option).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/xcfa/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Shizuka.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="xcfa" />
      <add key="ClearTextPassword" value="%PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
