<Project Sdk="Microsoft.NET.Sdk">

  <!-- The contract of Convy's sources: content sources, download payloads, the Gallery protocol. BCL only. Gallery
       sources from outside are Shizuka source extensions (Convy.Services/Extensions), not built against this. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Convy.Sources</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
