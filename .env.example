# Copy to `.env` and fill in your real values. `.env` is git-ignored.
# docker-compose reads these and injects them into the container.

# Base URL of your qBittorrent Web UI
QBITTORRENT__URL=https://qbittorrent.example.com

# qBittorrent Web UI credentials
QBITTORRENT__USERNAME=your-username
QBITTORRENT__PASSWORD=your-password

# Poll interval (h:m:s). 0 disables syncing.
QBITTORRENT__SYNCINTERVAL=0:0:5

# Prowlarr (search sources for the agent). Optional.
PROWLARR__URL=http://prowlarr:9696
PROWLARR__APIKEY=your-prowlarr-api-key

# slskd (Soulseek search and downloads). Optional.
SLSKD__URL=http://slskd:5030
SLSKD__APIKEY=your-slskd-api-key
# slskd's downloads directory as seen by Convy, if it differs from slskd's own setting.
# SLSKD__DOWNLOADSPATH=/data/slskd

# Key the agent must send to /mcp (X-Api-Key or Authorization: Bearer).
# Without it the MCP endpoint is closed.
MCP__APIKEY=a-long-random-secret

# Web UI sign-in with OpenID Connect (Authelia). The UI is off until these are set.
# Put the client secret into a Docker secret named Ui__Oidc__ClientSecret, not here.
UI__PUBLICURL=https://convy.example.com
UI__OIDC__AUTHORITY=https://auth.example.com
UI__OIDC__CLIENTID=convy
# UI__OIDC__ALLOWEDGROUPS__0=admins
# UI__OIDC__LOGOUTURL=https://auth.example.com/logout
